{
  "name": "worldcap",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "cross-env NODE_ENV=development tsx watch server/index.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build --outDir public",
    "build:server": "tsc -p server/tsconfig.json",
    "typecheck": "npm run typecheck:web && npm run typecheck:server",
    "typecheck:web": "tsc --noEmit",
    "typecheck:server": "tsc -p server/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "tsx --test src/domains/**/*.test.ts server/*.test.ts scripts/*.test.mjs",
    "validate:env": "node scripts/validate-environment.mjs",
    "smoke:beta": "node scripts/smoke-beta.mjs",
    "start:server": "cross-env NODE_ENV=production node server/dist/index.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "@worldcoin/idkit-core": "4.2.3",
    "@worldcoin/minikit-js": "^2.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.55.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.3.6"
  }
}
