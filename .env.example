# Frontend. The bypass is honored only by Vite development builds.
VITE_ENABLE_DEV_AUTH=false
VITE_BACKEND_URL=http://127.0.0.1:3001
VITE_WORLD_APP_ID=app_xxxxxxxxxxxxxxx
VITE_ENABLE_DEV_FAKE_PAYMENTS=false

# Server authentication. Session RP signatures are actionless by IDKit 4.x design;
# WORLD_ID_ACTION is still validated fail-closed for future action-scoped proofs.
NODE_ENV=development
WORLDPRIZE_ENV=development
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
WORLD_RP_ID=rp_xxxxxxxxxxxxxxx
WORLD_RP_SIGNING_KEY=
WORLD_ID_ACTION=worldprize-login
APP_SESSION_SECRET=
APP_IDENTITY_SECRET=
ENABLE_DEV_AUTH=false

# World Pay. WORLD_APP_ID and API key are server-only; do not add VITE_ prefixes.
WORLD_APP_ID=app_xxxxxxxxxxxxxxx
WORLD_DEVELOPER_API_KEY=
WORLDPRIZE_PAYMENT_RECIPIENT=0x0000000000000000000000000000000000000000
# Allowed only with NODE_ENV=development and WORLDPRIZE_ENV=development.
ENABLE_DEV_FAKE_PAYMENTS=false

# Closed beta only: creates explicitly non-monetary demo acquisitions. It is
# rejected in production and cannot coexist with a Developer API key.
ENABLE_BETA_DEMO_PURCHASES=false
ENABLE_BACKGROUND_WORKERS=false
PUBLIC_MANIFEST_BUCKET=worldcap-public-draws
# Comma-separated internal user IDs for the read-only Founder Control Center.
# Server-only: never expose this through a VITE_ variable.
FOUNDER_USER_IDS=

# Draw randomness. Deterministic provider is development/test-only and must be explicitly enabled.
ENABLE_DEV_DRAW_RANDOMNESS=false
DEV_DRAW_RANDOMNESS_SEED=replace-with-at-least-16-development-only-characters

# World Chain Sepolia trust infrastructure. No address is assumed: confirm the
# current Witnet deployment from primary documentation before enabling.
WITNET_NETWORK=world-chain-sepolia
WORLD_CHAIN_CHAIN_ID=4801
WORLD_CHAIN_RPC_URL=https://worldchain-sepolia.g.alchemy.com/public
WORLD_CHAIN_SEPOLIA_RPC_URL=https://worldchain-sepolia.g.alchemy.com/public
WITNET_RANDOMNESS_CONTRACT=0x0000000000000000000000000000000000000000
DRAW_COMMITMENT_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000

# Server-only persistence. Never prefix these values with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Explicit development-only in-memory identity persistence.
ENABLE_DEV_MOCK_PERSISTENCE=false
# Explicit local-only product-tour seed. Forbidden outside NODE_ENV=development.
ENABLE_LOCAL_BETA_SEED=false
